{
  "version": 1,
  "current_step": "STEP_001",
  "invariants": [
    "Do not mark VERIFIED without running verification.",
    "Only work on current_step unless explicitly unlocked.",
    "Test each step before advancing."
  ],
  "steps": [
    {
      "id": "STEP_001",
      "objective": "Example: Verify skill structure is intact",
      "status": "VERIFIED",
      "depends_on": [],
      "verify": [
        {
          "type": "file_exists",
          "file": "skills/plansm/SKILL.md"
        },
        {
          "type": "file_exists",
          "file": "skills/plansm/scripts/verify.sh"
        },
        {
          "type": "command",
          "cmd": "test -d skills/plansm/references",
          "expect": {
            "exit_code": 0
          }
        }
      ]
    },
    {
      "id": "STEP_002",
      "objective": "Example: Verify all shell scripts have proper headers",
      "status": "PENDING",
      "depends_on": ["STEP_001"],
      "verify": [
        {
          "type": "glob_pattern_check",
          "glob": "skills/plansm/scripts/*.sh",
          "pattern": "#!/bin/bash",
          "expect": {
            "min_count": 3
          }
        }
      ]
    }
  ]
}
